---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/site';

const entries = (await getCollection('work', (e) => e.data.card)).sort(
  (a, b) => a.data.order - b.data.order
);

function href(entry: (typeof entries)[number]): string | null {
  if (entry.data.caseStudy) return withBase(`/work/${entry.id}/`);
  if (entry.data.link) return entry.data.link.href;
  return null;
}
---

<section id="projects" class="chapter" data-oct-state="projects">
  <div class="oct-anchor pr__anchor" data-oct-anchor="projects" aria-hidden="true"></div>

  <div class="chapter-head">
    <div class="meta">
      <p class="label label--signal">L2 &middot; Systems</p>
      <p class="label">Three, deep &middot; <span class="hatch">////////</span></p>
    </div>
    <div class="counter" aria-hidden="true"><span class="n">03</span><span class="d">/ 06</span></div>
  </div>

  <h2 data-reveal>Built to be taken apart</h2>

  <div class="cards" data-reveal style="--i: 1">
    {
      entries.map((e) => {
        const h = href(e);
        const ext = h !== null && h.startsWith('http');
        return (
          <article class="card">
            <p class="label">{e.data.meta}</p>
            <h3>
              {h ? (
                <a href={h} rel={ext ? 'noopener' : undefined}>
                  {e.data.title} {ext ? '↗' : '→'}
                </a>
              ) : (
                e.data.title
              )}
            </h3>
            <p class="card__blurb">{e.data.blurb}</p>
            <div class="card__rule" aria-hidden="true" />
            <ul class="card__detail">
              {e.data.detail.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>

  <p class="label pr__also" data-reveal style="--i: 2">
    Also &mdash; multiplayer networking (UDP/TCP, Steam, LAN) &middot; OpenGL, Vulkan, PS4/PS5
    pipelines &middot; Android and Lua shipped to Google Play
  </p>
</section>

<style>
  .pr__anchor {
    right: -22%;
    top: 4%;
    --aw: min(22vmin, 14rem);
  }
  .card__blurb {
    font-size: 0.9rem;
    color: var(--text-2);
  }
  .pr__also {
    margin-top: 1.75rem;
    max-width: none;
  }
</style>
