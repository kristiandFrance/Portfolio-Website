---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/site';

const entries = (await getCollection('work', (e) => e.data.card)).sort(
  (a, b) => a.data.order - b.data.order
);

function href(entry: (typeof entries)[number]): string | null {
  if (entry.data.caseStudy) return withBase(`/work/${entry.id}/`);
  if (entry.data.link) return entry.data.link.href;
  return null;
}
---

<section id="projects" class="scene" data-oct-state="projects">
  <div class="scene__stage">
    <div class="oct-anchor pr__anchor" data-oct-anchor="projects" aria-hidden="true"></div>
    <div class="stage__head">
      <div class="meta">
        <p class="label label--signal">L2 &middot; Systems</p>
        <p class="label">Three, deep &middot; <span class="hatch">////////</span></p>
      </div>
      <div class="counter" aria-hidden="true"><span class="n">03</span><span class="d">/ 06</span></div>
    </div>
    <ul class="stage__ticks" aria-hidden="true">
      {entries.map(() => <li></li>)}
    </ul>
  </div>

  {
    entries.map((e, i) => {
      const h = href(e);
      const ext = h !== null && h.startsWith('http');
      return (
        <div class="step" data-step={i}>
          <article class="pr__item">
            <p class="label">{e.data.meta}</p>
            <h2 class="pr__title">
              {h ? (
                <a href={h} rel={ext ? 'noopener' : undefined}>
                  {e.data.title} {ext ? '↗' : '→'}
                </a>
              ) : (
                e.data.title
              )}
            </h2>
            <p class="pr__blurb">{e.data.blurb}</p>
            <ul class="pr__detail">
              {e.data.detail.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </article>
        </div>
      );
    })
  }
</section>

<style>
  .pr__anchor {
    right: -16%;
    top: 14%;
    --aw: min(26vmin, 16rem);
  }
  .pr__item {
    max-width: 44rem;
  }
  @media (min-width: 64rem) {
    .pr__item {
      max-width: min(44rem, 56vw);
    }
  }
  .pr__title {
    margin: 0.7rem 0 1rem;
  }
  .pr__title a {
    transition: color 0.3s var(--ease);
  }
  .pr__title a:hover,
  .pr__title a:focus-visible {
    color: var(--signal);
  }
  .pr__blurb {
    color: var(--text-2);
    font-size: 1.02rem;
  }
  .pr__detail {
    list-style: none;
    padding: 0;
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--rule-soft);
    border: 1px solid var(--rule-soft);
  }
  @media (min-width: 40rem) {
    .pr__detail {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pr__detail li {
    background: var(--ground);
    padding: 0.7rem 0.95rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
</style>
