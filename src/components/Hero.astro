---
import { SITE, withBase } from '../lib/site';

const poster = withBase('/poster-octree.svg');
---

<section id="top" class="hero chapter" data-octree-state="hero" aria-label="Introduction">
  <div class="octree-wrap" aria-hidden="true">
    <canvas class="octree-canvas" data-octree-canvas></canvas>
    <img
      class="octree-poster"
      src={poster}
      alt=""
      width="1200"
      height="1200"
      hidden
      data-octree-poster
    />
    <noscript>
      <img class="octree-poster" src={poster} alt="" width="1200" height="1200" />
    </noscript>
  </div>

  <div class="hero-content">
    <div class="hero-copy">
      <p class="mono-label eyebrow">Software Engineer — Auckland, NZ</p>
      <h1>Kristian de&nbsp;France</h1>
      <p class="sub soft">Systems, engines and the things underneath games.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#work">See the work ↓</a>
        <a class="wipe-link email-link" href={`mailto:${SITE.email}`}>Email me</a>
      </div>
    </div>
    <p class="mono-label readout" data-octree-readout aria-live="off">Sparse voxel octree</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: var(--space-3) var(--gutter) var(--space-3);
  }

  .octree-wrap {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
    /* above the body background, below every section's in-flow content */
    z-index: -1;
  }
  @media (min-width: 64rem) {
    .octree-wrap {
      position: fixed;
    }
  }
  .octree-canvas,
  .octree-poster {
    width: 100%;
    height: 100%;
  }
  .octree-poster {
    object-fit: contain;
    padding: 12vmin;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .eyebrow {
    margin-bottom: var(--space-2);
  }
  .sub {
    margin-top: var(--space-2);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
  }
  .cta-row {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .email-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-block: 0.95rem; /* touch target ≥44px */
  }
  .readout {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-2);
  }

  /* on phones the object gets the top half, copy the bottom */
  @media (max-width: 63.99rem) {
    .octree-wrap {
      bottom: 38%;
    }
    .hero-content {
      margin-top: 52svh;
    }
  }
</style>

<script>
  import { initOctree } from '../scripts/octree-scene.js';

  const canvas = document.querySelector('[data-octree-canvas]');
  const readouts = document.querySelectorAll('[data-octree-readout]');
  const posterEl = document.querySelector('[data-octree-poster]');

  function webglAvailable() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  if (canvas instanceof HTMLCanvasElement && webglAvailable()) {
    initOctree({ canvas, posterEl });
  } else {
    if (canvas) canvas.hidden = true;
    if (posterEl) posterEl.hidden = false;
    readouts.forEach((el) => {
      el.textContent = 'SPARSE VOXEL OCTREE · STATIC RENDER';
    });
  }
</script>
