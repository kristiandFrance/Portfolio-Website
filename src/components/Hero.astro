---
import { SITE, withBase } from '../lib/site';

const poster = withBase('/poster-octree.svg');
---

<section id="top" class="chapter hero" data-oct-state="hero" aria-label="Introduction">
  <!-- the object lives here; CSS owns the composition -->
  <div class="oct-anchor hero__anchor" data-oct-anchor="hero" aria-hidden="true"></div>

  <div class="hero__brackets">
    <p class="label brk">Systems, engines and the things underneath games</p>
    <p class="label brk hero__brk-r">Auckland, New Zealand &middot; open to work</p>
  </div>

  <div class="hero__body">
    <p class="label" data-reveal>Software Engineer</p>
    <h1 data-reveal style="--i: 1">
      Kristian<br />de&nbsp;<span class="gold">France</span>
    </h1>
    <p class="hero__sub" data-reveal style="--i: 2">
      Four years in C++ and C#. Engine systems, AI navigation and a shipped Steam title &mdash;
      the object beside this is a real sparse voxel octree, built in your browser.
    </p>
    <div class="hero__cta" data-reveal style="--i: 3">
      <a class="btn btn--primary" href="#work">
        <span class="btn__lines" aria-hidden="true"></span>
        <i class="btn__tick"></i><i class="btn__tick"></i><i class="btn__tick"></i>
        <i class="btn__tick"></i><i class="btn__tick"></i><i class="btn__tick"></i>
        <span class="btn__txt">Enter the work</span>
      </a>
      <a class="link" href={`mailto:${SITE.email}`}>Email &rarr;</a>
    </div>
  </div>

  <p class="label hero__readout" data-oct-readout aria-live="off">Sparse voxel octree</p>

  <noscript>
    <img class="hero__poster" src={poster} alt="" width="1200" height="1200" />
  </noscript>
</section>

<style>
  .hero {
    align-content: end;
  }
  .hero__anchor {
    /* desktop: right of centre, vertically middle */
    left: 52%;
    top: 46%;
    transform: translate(-10%, -50%);
    --aw: min(46vmin, 34rem);
  }
  .hero__brackets {
    position: absolute;
    top: calc(var(--header-h) + 1.5rem);
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }
  .hero__brackets p {
    max-width: 22ch;
    margin: 0;
  }
  .hero__brk-r {
    text-align: right;
  }
  .hero__body {
    max-width: 34rem;
  }
  h1 {
    margin: 0.6rem 0 1.25rem;
  }
  .hero__sub {
    color: var(--text-2);
    font-size: 1.02rem;
    max-width: 40ch;
  }
  .hero__cta {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }
  .hero__readout {
    position: absolute;
    left: var(--gutter);
    bottom: 1.6rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.7rem;
    min-width: 17rem;
  }
  .hero__poster {
    width: 60vmin;
    margin: 2rem auto;
    opacity: 0.5;
  }

  /* phones: object above, copy below — never overlapping */
  @media (max-width: 63.99rem) {
    .hero {
      align-content: center;
    }
    .hero__anchor {
      --aw-m: min(52vmin, 17rem);
    }
    .hero__brackets {
      display: none;
    }
    .hero__readout {
      position: static;
      margin-top: 2rem;
    }
  }
  @media (orientation: landscape) and (max-height: 700px) {
    .hero__anchor {
      --aw: min(38vmin, 22rem);
    }
    .hero__brackets {
      display: none;
    }
  }
</style>

<script>
  import { initOctree } from '../scripts/octree-scene.js';

  const canvas = document.querySelector('[data-oct-canvas]');
  const posterEl = document.querySelector('[data-oct-poster]');

  function webglOK() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  const ready = () => document.dispatchEvent(new CustomEvent('octree:ready'));

  if (canvas instanceof HTMLCanvasElement && webglOK()) {
    initOctree({ canvas, posterEl, onReady: ready });
  } else {
    if (canvas) canvas.hidden = true;
    if (posterEl) posterEl.hidden = false;
    document.querySelectorAll('[data-oct-readout]').forEach((el) => {
      el.textContent = 'SPARSE VOXEL OCTREE · STATIC RENDER';
    });
    ready();
  }
</script>
