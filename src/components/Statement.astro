---
const line =
  'I’ve always enjoyed taking things apart — not just to understand how they work, but why they were built that way and how they could be improved.';
---

<section id="statement" class="chapter statement" data-oct-state="statement" aria-label="Statement">
  <div class="oct-anchor st__anchor" data-oct-anchor="statement" aria-hidden="true"></div>

  <div class="chapter-head">
    <div class="meta">
      <p class="label label--signal">L0 &middot; Thesis</p>
      <p class="label">The shape of the thinking &middot; <span class="hatch">////////</span></p>
    </div>
    <div class="counter" aria-hidden="true"><span class="n">01</span><span class="d">/ 06</span></div>
  </div>

  <blockquote class="split st__quote">
    <p class="sr-only">{line}</p>
    <p class="st__text" data-split aria-hidden="true">{line}</p>
  </blockquote>

  <p class="label st__readout" data-oct-readout aria-live="off" data-reveal style="--i: 2">
    Sparse voxel octree
  </p>
</section>

<style>
  .st__anchor {
    right: 2%;
    top: 50%;
    transform: translateY(-50%);
    --aw: min(40vmin, 27rem);
  }
  .st__quote {
    margin: 0;
    max-width: 40rem;
  }
  @media (min-width: 64rem) {
    .st__quote {
      max-width: min(40rem, 50vw);
    }
  }
  .st__text {
    font-family: var(--display);
    font-size: clamp(1.3rem, 2.9vw, 2.35rem);
    line-height: 1.2;
    color: var(--text);
    text-transform: none;
    letter-spacing: 0.005em;
    max-width: none;
  }
  .st__readout {
    margin-top: 2.5rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
    max-width: 20rem;
  }
  @media (max-width: 63.99rem) {
    .st__anchor {
      --aw-m: 40vmin;
    }
  }
</style>
