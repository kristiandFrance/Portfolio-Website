---
import { SITE, withBase } from '../lib/site';
const home = withBase('/');
---

<header class="hdr">
  <div class="hdr__in">
    <a class="hdr__mark" href={home} aria-label="Kristian de France — home">
      <span class="hdr__mark-n">KDF</span>
      <span class="hdr__mark-s">Kristian de France</span>
    </a>

    <div class="hdr__right">
      <a class="link hdr__ext" href={SITE.github} rel="me noopener">GitHub</a>
      <a class="link hdr__ext" href={SITE.linkedin} rel="me noopener">LinkedIn</a>
      <a class="btn hdr__cta" href={`${home}#contact`}>
        <span class="btn__lines" aria-hidden="true"></span>
        <i class="btn__tick"></i><i class="btn__tick"></i><i class="btn__tick"></i>
        <i class="btn__tick"></i><i class="btn__tick"></i><i class="btn__tick"></i>
        <span class="btn__txt">Contact</span>
      </a>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    border-bottom: 1px solid var(--rule-soft);
    background: linear-gradient(to bottom, var(--ground) 55%, transparent);
    backdrop-filter: blur(6px);
  }
  .hdr__in {
    max-width: var(--frame);
    margin-inline: auto;
    height: var(--header-h);
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .hdr__mark {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--display);
    color: var(--text);
    letter-spacing: 0.14em;
    font-size: 0.9rem;
  }
  .hdr__mark-s {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .hdr__right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .hdr__cta {
    padding: 0.6rem 1rem;
    min-height: 38px;
  }
  @media (max-width: 47.99rem) {
    .hdr__mark-s,
    .hdr__ext {
      display: none;
    }
  }
</style>
