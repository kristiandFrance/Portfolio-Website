---
import { SITE } from '../lib/site';

const links = [
  { label: 'GitHub', href: SITE.github },
  { label: 'LinkedIn', href: SITE.linkedin },
  { label: "Steam — You're Here Again", href: SITE.steam },
  { label: 'itch — Tangle Tails', href: SITE.itch },
];
---

<section id="contact" class="chapter contact" data-oct-state="contact">
  <div class="oct-anchor ct__anchor" data-oct-anchor="contact" aria-hidden="true"></div>

  <div class="chapter-head">
    <div class="meta">
      <p class="label label--signal">L4 &middot; Contact</p>
      <p class="label">Open to engineering roles &mdash; Auckland or remote &middot; <span class="hatch">////////</span></p>
    </div>
    <div class="counter" aria-hidden="true"><span class="n">06</span><span class="d">/ 06</span></div>
  </div>

  <div class="ct__body">
    <h2 data-reveal>Let’s talk</h2>
    <p class="ct__mail" data-reveal style="--i: 1">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
    <ul class="ct__links" data-reveal style="--i: 2">
      {
        links.map((l) => (
          <li>
            <a class="link" href={l.href} rel="noopener">
              {l.label} &#8599;
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ct__anchor {
    right: 4%;
    top: 50%;
    transform: translateY(-50%);
    --aw: min(36vmin, 24rem);
  }
  .ct__body {
    max-width: 46rem;
  }
  @media (min-width: 64rem) {
    .ct__body {
      max-width: 52vw;
    }
  }
  .ct__mail {
    margin-top: 1.25rem;
    max-width: none;
  }
  .ct__mail a {
    font-family: var(--display);
    font-size: clamp(1.15rem, 3.4vw, 2.6rem);
    color: var(--text);
    overflow-wrap: anywhere;
    background-image: linear-gradient(var(--signal), var(--signal));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition:
      background-size 0.4s var(--ease),
      color 0.4s var(--ease);
    padding-bottom: 0.12em;
  }
  .ct__mail a:hover,
  .ct__mail a:focus-visible {
    background-size: 100% 1px;
    color: var(--signal);
  }
  .ct__links {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
  }
  @media (max-width: 63.99rem) {
    .ct__anchor {
      --aw-m: 38vmin;
    }
  }
</style>
