---
/**
 * The handover. A quadtree cell folds open to depth 3, holds, folds back,
 * and loops — while a copper agent walks the lattice it just built. It is
 * the site's whole thesis compressed into a 120px loop, and it runs until
 * the real octree is ready behind it.
 */
---

<div class="pre" id="preloader">
  <div class="pre__inner">
    <svg class="pre__mark" viewBox="0 0 120 120" role="img" aria-label="Loading">
      <!-- the agent, walking the cells -->
      <rect class="pre__agent" x="0" y="0" width="12.5" height="12.5" />
      <g class="pre__grid" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke">
        <rect class="lvl lvl0" x="10" y="10" width="100" height="100" stroke-width="1.1"></rect>
        <path class="lvl lvl1" d="M60 10v100M10 60h100" stroke-width="0.9"></path>
        <path class="lvl lvl2" d="M35 10v100M85 10v100M10 35h100M10 85h100" stroke-width="0.7"></path>
        <path
          class="lvl lvl3"
          d="M22.5 10v100M47.5 10v100M72.5 10v100M97.5 10v100M10 22.5h100M10 47.5h100M10 72.5h100M10 97.5h100"
          stroke-width="0.5"></path>
      </g>
    </svg>

    <p class="label pre__name">Kristian de France</p>
    <div class="pre__bar" aria-hidden="true"><i></i></div>
    <p class="label pre__pct">
      <span data-pre-pct>0</span>% &middot; <span data-pre-msg>Building octree</span>
    </p>
  </div>
</div>

<style>
  .pre {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--ground);
    display: grid;
    place-items: center;
    transition:
      opacity 0.9s var(--ease),
      visibility 0.9s var(--ease);
  }
  .pre.gone {
    opacity: 0;
    visibility: hidden;
  }
  .pre__inner {
    display: grid;
    justify-items: center;
    gap: 1.15rem;
    padding: var(--gutter);
  }
  .pre__mark {
    width: clamp(96px, 17vmin, 150px);
    height: auto;
    color: var(--rule-strong);
    overflow: visible;
  }

  /* each depth folds open in sequence, then the whole thing folds back —
     `alternate` gives the return leg for free, and the stagger makes it
     cascade outward-in on the way out */
  .lvl {
    transform-box: view-box;
    transform-origin: 50% 50%;
    opacity: 0;
    animation: fold 1.15s var(--ease) infinite alternate;
  }
  .lvl0 {
    animation-delay: 0s;
  }
  .lvl1 {
    animation-delay: 0.16s;
  }
  .lvl2 {
    animation-delay: 0.32s;
  }
  .lvl3 {
    animation-delay: 0.48s;
    color: var(--signal);
    stroke: var(--signal);
  }

  @keyframes fold {
    0% {
      opacity: 0;
      transform: scale(0.72);
    }
    55%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* the agent traverses the leaf cells, the way the real one does */
  .pre__agent {
    fill: var(--ember);
    transform-box: view-box;
    opacity: 0.9;
    animation: walk 3.4s var(--ease) infinite;
  }
  @keyframes walk {
    0%   { transform: translate(22.5px, 35px); }
    16%  { transform: translate(47.5px, 35px); }
    32%  { transform: translate(47.5px, 60px); }
    48%  { transform: translate(72.5px, 60px); }
    64%  { transform: translate(72.5px, 22.5px); }
    80%  { transform: translate(35px, 22.5px); }
    100% { transform: translate(22.5px, 35px); }
  }

  .pre__name {
    color: var(--text);
    letter-spacing: 0.3em;
  }
  .pre__bar {
    width: min(230px, 52vw);
    height: 1px;
    background: var(--rule-soft);
    overflow: hidden;
  }
  .pre__bar i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--signal);
    transition: width 0.4s var(--ease);
  }
  .pre__pct {
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .lvl {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .pre__agent {
      animation: none;
      transform: translate(47.5px, 60px);
    }
  }
</style>

<script>
  const pre = document.getElementById('preloader');
  const pctEl = document.querySelector('[data-pre-pct]');
  const msgEl = document.querySelector('[data-pre-msg]');
  const bar = document.querySelector('.pre__bar i');

  let pct = 0;
  let done = false;
  const steps = ['Building octree', 'Subdividing', 'Linking graph', 'Ready'];

  const creep = setInterval(() => {
    pct = Math.min(pct + Math.random() * 9 + 3, 92);
    paint();
  }, 130);

  function paint() {
    const v = Math.round(pct);
    if (pctEl) pctEl.textContent = String(v);
    if (bar) bar.style.width = v + '%';
    if (msgEl) {
      const i = Math.min(steps.length - 1, Math.floor((v / 100) * steps.length));
      msgEl.textContent = steps[i];
    }
  }

  function handover() {
    if (done) return;
    done = true;
    clearInterval(creep);
    pct = 100;
    paint();
    setTimeout(() => {
      pre?.classList.add('gone');
      document.body.classList.add('ready');
      document.dispatchEvent(new CustomEvent('site:ready'));
    }, 420);
  }

  document.addEventListener('octree:ready', handover, { once: true });
  setTimeout(handover, 6000);
  window.addEventListener('load', () => setTimeout(handover, 2200));
</script>
