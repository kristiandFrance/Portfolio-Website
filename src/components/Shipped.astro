---
import { SITE, withBase } from '../lib/site';

const stats = [
  { n: '33', label: 'levels' },
  { n: '3', label: 'bosses' },
  { n: '10+', label: 'enemy types' },
  { n: '4', label: 'languages' },
  { n: '7', label: 'achievements' },
  { n: '1', label: 'soundtrack DLC' },
];

const owned = [
  'Weapon systems — feel, timing, interaction with the movement kit',
  'AI systems across 10+ enemy types',
  'Audio direction, SFX and original music',
  'VFX systems and in-game feedback',
  'Bug-reporting pipeline players can fire from inside the game',
  'Post-launch updates, optimisation and CI/CD',
];

const clip = withBase('/media/yha-clip.mp4');
const posterImg = withBase('/media/yha-poster.jpg');
---

<section id="work" class="chapter shipped" data-oct-state="shipped">
  <div class="oct-anchor sh__anchor" data-oct-anchor="shipped" aria-hidden="true"></div>

  <div class="chapter-head">
    <div class="meta">
      <p class="label label--signal">L1 &middot; Shipped &mdash; Steam, Early Access</p>
      <p class="label">Devious Devs &middot; 13 Dec 2025 &middot; <span class="hatch">////////</span></p>
    </div>
    <div class="counter" aria-hidden="true"><span class="n">02</span><span class="d">/ 06</span></div>
  </div>

  <div class="sh__grid">
    <div class="sh__left">
      <h2 data-reveal>You’re Here Again</h2>
      <p class="sh__lede" data-reveal style="--i: 1">
        A weirdcore movement shooter set in the liminal space between death and whatever follows.
        Wall-runs, slides, grapples and slams chain together, and damage scales with how fast
        you’re moving.
      </p>

      <p class="label sh__owned-t" data-reveal style="--i: 2">What I owned</p>
      <ol class="deliverables" data-reveal style="--i: 2">
        {owned.map((o) => <li>{o}</li>)}
      </ol>

      <p class="sh__credit label" data-reveal style="--i: 3">
        One of five developers &middot; credited on Steam as yodapowers_
      </p>

      <div class="sh__cta" data-reveal style="--i: 3">
        <a class="btn" href={SITE.steam} rel="noopener">
          <span class="btn__lines" aria-hidden="true"></span>
          <i class="btn__tick"></i><i class="btn__tick"></i><i class="btn__tick"></i>
          <i class="btn__tick"></i><i class="btn__tick"></i><i class="btn__tick"></i>
          <span class="btn__txt">View on Steam &#8599;</span>
        </a>
        <a class="link" href={withBase('/work/youre-here-again/')}>Case study &rarr;</a>
      </div>
    </div>

    <div class="sh__right">
      <figure class="cell" data-reveal style="--i: 2">
        <video
          data-yha-clip
          src={clip}
          poster={posterImg}
          preload="none"
          muted
          loop
          playsinline
          width="1280"
          height="720"
          aria-label="Silent gameplay clip from You're Here Again. Click to pause."
        ></video>
        <figcaption>In-game &middot; movement kit vs the liminal space</figcaption>
      </figure>

      <dl class="stats" data-reveal style="--i: 3">
        {
          stats.map((s) => (
            <div class="stat">
              <dd>{s.n}</dd>
              <dt>{s.label}</dt>
            </div>
          ))
        }
      </dl>
      <p class="label sh__langs" data-reveal style="--i: 3">
        English &middot; Simplified Chinese &middot; Russian &middot; Te Reo M&#257;ori
      </p>
    </div>
  </div>
</section>

<style>
  /* object parked far right, small — this chapter carries its own media */
  .sh__anchor {
    right: -20%;
    top: 6%;
    --aw: min(24vmin, 15rem);
  }
  .sh__grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 56rem) {
    .sh__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
  }
  .sh__lede {
    margin-top: 0.9rem;
    color: var(--text-2);
  }
  .sh__owned-t {
    margin-top: 1.6rem;
    margin-bottom: 0.5rem;
  }
  .sh__credit {
    margin-top: 1rem;
  }
  .sh__cta {
    margin-top: 1.4rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .sh__right {
    display: grid;
    gap: 1.25rem;
  }
  .sh__langs {
    margin-top: -0.5rem;
  }
  .cell video {
    cursor: pointer;
  }
  @media (orientation: landscape) and (max-height: 800px) {
    .deliverables li {
      padding: 0.4rem 0;
      font-size: 0.82rem;
    }
  }
</style>

<script>
  const v = document.querySelector('[data-yha-clip]') as HTMLVideoElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (v) {
    let held = false;
    v.addEventListener('click', () => {
      if (v.paused) { held = false; v.play().catch(() => {}); }
      else { held = true; v.pause(); }
    });
    if (!reduced) {
      new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting && !held) v.play().catch(() => {});
          else if (!e.isIntersecting && !v.paused) v.pause();
        },
        { threshold: 0.3 }
      ).observe(v);
    }
  }
</script>
