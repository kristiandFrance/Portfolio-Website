---
import { SITE, withBase } from '../lib/site';

const stats = [
  { n: '33', label: 'levels' },
  { n: '3', label: 'bosses' },
  { n: '10+', label: 'enemy types' },
  { n: '4', label: 'languages' },
  { n: '7', label: 'achievements' },
  { n: '1', label: 'soundtrack DLC' },
];

const owned = [
  'Weapon systems — feel, timing, interaction with the movement kit',
  'AI systems across 10+ enemy types',
  'Audio direction, SFX and original music',
  'VFX systems and in-game feedback',
  'Bug-reporting pipeline players can fire from inside the game',
  'Post-launch updates, optimisation and CI/CD',
];

const clip = withBase('/media/yha-clip.mp4');
const posterImg = withBase('/media/yha-poster.jpg');
---

<section id="work" class="scene" data-oct-state="shipped">
  <div class="scene__stage">
    <div class="oct-anchor sh__anchor" data-oct-anchor="shipped" aria-hidden="true"></div>
    <div class="stage__head">
      <div class="meta">
        <p class="label label--signal">L1 &middot; Shipped &mdash; Steam, Early Access</p>
        <p class="label">Devious Devs &middot; 13 Dec 2025 &middot; <span class="hatch">////////</span></p>
      </div>
      <div class="counter" aria-hidden="true"><span class="n">02</span><span class="d">/ 06</span></div>
    </div>
    <ul class="stage__ticks" aria-hidden="true"><li></li><li></li><li></li></ul>
  </div>

  <div class="step" data-step="0">
    <div class="sh__narrow">
      <h2>You’re Here Again</h2>
      <p class="sh__lede">
        A weirdcore movement shooter set in the liminal space between death and whatever follows.
        Wall-runs, slides, grapples and slams chain together, and damage scales with how fast
        you’re moving.
      </p>
      <p class="label sh__credit">One of five developers &middot; credited on Steam as yodapowers_</p>
      <div class="sh__cta">
        <a class="btn" href={SITE.steam} rel="noopener">
          <span class="btn__lines" aria-hidden="true"></span>
          <i class="btn__tick"></i><i class="btn__tick"></i><i class="btn__tick"></i>
          <i class="btn__tick"></i><i class="btn__tick"></i><i class="btn__tick"></i>
          <span class="btn__txt">View on Steam &#8599;</span>
        </a>
        <a class="link" href={withBase('/work/youre-here-again/')}>Case study &rarr;</a>
      </div>
    </div>
  </div>

  <div class="step" data-step="1">
    <div class="sh__narrow">
      <p class="label label--signal">What I owned</p>
      <ol class="deliverables">
        {owned.map((o) => <li>{o}</li>)}
      </ol>
    </div>
  </div>

  <div class="step" data-step="2">
    <div class="sh__wide">
      <figure class="cell">
        <video
          data-yha-clip
          src={clip}
          poster={posterImg}
          preload="none"
          muted
          loop
          playsinline
          width="1280"
          height="720"
          aria-label="Silent gameplay clip from You're Here Again. Click to pause."
        ></video>
        <figcaption>In-game &middot; movement kit vs the liminal space</figcaption>
      </figure>
      <dl class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <dd>{s.n}</dd>
              <dt>{s.label}</dt>
            </div>
          ))
        }
      </dl>
      <p class="label sh__langs">
        English &middot; Simplified Chinese &middot; Russian &middot; Te Reo M&#257;ori
      </p>
    </div>
  </div>
</section>

<style>
  .sh__anchor {
    right: -14%;
    top: 12%;
    --aw: min(28vmin, 17rem);
  }
  .sh__narrow {
    max-width: 40rem;
  }
  .sh__wide {
    max-width: 46rem;
    display: grid;
    gap: 1.25rem;
  }
  .sh__lede {
    margin-top: 0.9rem;
    color: var(--text-2);
  }
  .sh__credit {
    margin-top: 1.25rem;
  }
  .sh__cta {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .sh__langs {
    margin-top: -0.25rem;
  }
  .cell video {
    cursor: pointer;
  }
  @media (min-width: 64rem) {
    .sh__narrow,
    .sh__wide {
      max-width: min(46rem, 56vw);
    }
  }
  @media (orientation: landscape) and (max-height: 900px) {
    .sh__wide {
      gap: 0.85rem;
      max-width: min(40rem, 50vw);
    }
    .cell figcaption {
      padding: 0.5rem 0.8rem;
    }
    .sh__langs {
      margin-top: -0.5rem;
    }
  }
</style>

<script>
  const v = document.querySelector('[data-yha-clip]') as HTMLVideoElement | null;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (v) {
    let held = false;
    v.addEventListener('click', () => {
      if (v.paused) { held = false; v.play().catch(() => {}); }
      else { held = true; v.pause(); }
    });
    if (!reduced) {
      new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting && !held) v.play().catch(() => {});
          else if (!e.isIntersecting && !v.paused) v.pause();
        },
        { threshold: 0.3 }
      ).observe(v);
    }
  }
</script>
