---
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="ftr__in">
    <svg viewBox="0 0 1200 120" role="img" aria-label="Kristian de France" class="ftr__mark">
      <text x="0" y="96" textLength="1200" lengthAdjust="spacingAndGlyphs">KRISTIAN DE FRANCE</text>
    </svg>
    <div class="ftr__base">
      <p class="label">&copy; {year} &middot; Auckland, New Zealand</p>
      <p class="label">Built with Astro and Three.js &middot; <span class="hatch">////////</span></p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--rule);
    background: var(--ground);
  }
  .ftr__in {
    max-width: var(--frame);
    margin-inline: auto;
    padding: 2.5rem var(--gutter) 1.75rem;
  }
  .ftr__mark {
    width: 100%;
    height: auto;
  }
  .ftr__mark text {
    font-family: var(--display);
    font-size: 108px;
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 0.75;
    letter-spacing: 0.02em;
  }
  .ftr__base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--rule-soft);
    padding-top: 1rem;
  }
</style>
