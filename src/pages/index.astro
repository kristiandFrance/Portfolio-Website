---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Shipped from '../components/Shipped.astro';
import Projects from '../components/Projects.astro';
import Jam from '../components/Jam.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
---

<Base home>
  <Stage />
  <Rail />
  <main id="main" class="frame">
    <Hero />
    <Statement />
    <Shipped />
    <Projects />
    <Jam />
    <About />
    <Contact />
  </main>
</Base>
